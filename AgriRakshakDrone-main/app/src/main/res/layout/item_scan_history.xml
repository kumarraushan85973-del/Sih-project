<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_border"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Disease and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtHistoryDisease"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Leaf Blight"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtHistoryStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISEASE_DETECTED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/danger" />

        </LinearLayout>

        <!-- Confidence -->
        <TextView
            android:id="@+id/txtHistoryConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Confidence: 94.50%"
            android:textSize="15sp"
            android:textColor="@color/text_secondary" />

        <!-- Date and Time -->
        <TextView
            android:id="@+id/txtHistoryDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="04 Sep 2026, 04:00 PM"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

        <!-- GPS Location -->
        <TextView
            android:id="@+id/txtHistoryLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📍 28.613900, 77.209000"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>